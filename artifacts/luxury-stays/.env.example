# Values supplied by the Replit environment; never commit actual credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
CLERK_SECRET_KEY=sk_test_REPLIT_MANAGED
CLERK_PUBLISHABLE_KEY=pk_test_REPLIT_MANAGED
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLIT_MANAGED

# Add one or more Clerk user IDs for staff access, separated by commas.
ADMIN_CLERK_USER_IDS=

# Optional, comma-separated exact origins for external browser clients.
CORS_ORIGINS=
VITE_SITE_URL=https://your-production-domain.example

# Reserved until transactional email is connected.
RESEND_API_KEY=
EMAIL_FROM=
