generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum CouponKind {
  PERCENT
  FIXED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  sessionVersion Int      @default(0)
  bookings      Booking[]
  auditLogs     AuditLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model HotelSetting {
  id                    Int      @id @default(1)
  name                  String   @default("LuxuryStay Hotel & Resort")
  currency              String   @default("INR")
  timezone              String   @default("Asia/Kolkata")
  taxPercent            Decimal  @default(12) @db.Decimal(5, 2)
  cancellationHours     Int      @default(48)
  contactEmail          String?
  contactPhone          String?
  address               String?
  updatedAt             DateTime @updatedAt
}

model RoomType {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  description  String
  maxGuests    Int
  bedSummary   String
  areaSqm      Int
  basePrice    Decimal        @db.Decimal(12, 2)
  imageUrl     String
  featured     Boolean        @default(false)
  active       Boolean        @default(true)
  rooms        Room[]
  bookings     Booking[]
  seasonalRates SeasonalRate[]
  amenities    AmenityRoomType[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Room {
  id          String       @id @default(cuid())
  number      String       @unique
  typeId      String
  type        RoomType     @relation(fields: [typeId], references: [id], onDelete: Cascade)
  reservations BookingRoom[]
  createdAt   DateTime     @default(now())
}

model SeasonalRate {
  id          String   @id @default(cuid())
  roomTypeId  String
  roomType    RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  startsOn    DateTime @db.Date
  endsOn      DateTime @db.Date
  nightlyRate Decimal  @db.Decimal(12, 2)
  @@index([roomTypeId, startsOn, endsOn])
}

model Booking {
  id             String         @id @default(cuid())
  reference      String         @unique
  idempotencyKey String         @unique
  requestHash    String
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  roomTypeId     String
  roomType       RoomType       @relation(fields: [roomTypeId], references: [id])
  checkIn        DateTime       @db.Date
  checkOut       DateTime       @db.Date
  adults         Int
  children       Int            @default(0)
  roomCount      Int            @default(1)
  status         BookingStatus  @default(PENDING)
  expiresAt      DateTime
  subtotal       Decimal        @db.Decimal(12, 2)
  taxAmount      Decimal        @db.Decimal(12, 2)
  discountAmount Decimal       @db.Decimal(12, 2) @default(0)
  total          Decimal        @db.Decimal(12, 2)
  couponId       String?
  coupon         Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  guests         Guest[]
  rooms          BookingRoom[]
  payments       Payment[]
  refunds        Refund[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  @@index([checkIn, checkOut, status, expiresAt])
  @@index([userId, createdAt])
}

model BookingRoom {
  bookingId String
  roomId    String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  @@id([bookingId, roomId])
  @@index([roomId])
}

model Guest {
  id          String  @id @default(cuid())
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fullName    String
  email       String
  phone       String?
  isPrimary   Boolean @default(false)
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  orderId         String?       @unique
  paymentId       String?       @unique
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  idempotencyKey  String        @unique
  rawEvent        Json?
  refunds         Refund[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([bookingId, status])
}

model Refund {
  id            String   @id @default(cuid())
  idempotencyKey String  @unique
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentId     String
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  providerPaymentId String
  providerId    String?  @unique
  amount        Decimal  @db.Decimal(12, 2)
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
}

model Coupon {
  id          String      @id @default(cuid())
  code        String      @unique
  kind        CouponKind
  value       Decimal     @db.Decimal(12, 2)
  startsAt    DateTime?
  endsAt      DateTime?
  maxUses     Int?
  uses        Int         @default(0)
  active      Boolean     @default(true)
  bookings    Booking[]
}

model Amenity {
  id          String           @id @default(cuid())
  name        String           @unique
  description String
  icon        String           @default("sparkles")
  roomTypes   AmenityRoomType[]
}

model AmenityRoomType {
  amenityId  String
  roomTypeId String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  @@id([amenityId, roomTypeId])
}

model Review {
  id          String   @id @default(cuid())
  guestName   String
  quote       String
  rating      Int      @default(5)
  verified    Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  readAt    DateTime?
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model RateLimit {
  key              String   @id
  windowStartedAt  DateTime
  count            Int
  updatedAt        DateTime @updatedAt
}
